# Copia este archivo a .env (NO lo versiones) y completa los valores.
# Genera la clave HMAC con:  openssl rand -base64 48

# --- Base de datos ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT (obligatorio: la app falla al arrancar si falta o mide menos de 32 bytes) ---
PULSEPASS_JWT_SECRET_BASE64=
PULSEPASS_JWT_ISSUER=pulsepass-api
PULSEPASS_JWT_ACCESS_TTL=PT15M

# --- CORS (lista separada por comas; vacío = sin orígenes cruzados) ---
PULSEPASS_CORS_ALLOWED_ORIGINS=

# --- Cuentas privilegiadas LOCALES (solo con SPRING_PROFILES_ACTIVE=dev) ---
# Sin contraseña no se crea la cuenta. Mínimo 12 caracteres.
PULSEPASS_BOOTSTRAP_ADMIN_USERNAME=admin
PULSEPASS_BOOTSTRAP_ADMIN_EMAIL=admin@pulsepass.local
PULSEPASS_BOOTSTRAP_ADMIN_PASSWORD=
PULSEPASS_BOOTSTRAP_STAFF_USERNAME=staff
PULSEPASS_BOOTSTRAP_STAFF_EMAIL=staff@pulsepass.local
PULSEPASS_BOOTSTRAP_STAFF_PASSWORD=
